                disassyCode="00"
                disassyCodeVariant="A"
                infoCode="790"
                infoCodeVariant="A"
                itemLocationCode="A"/>
        <language languageIsoCode="en" countryIsoCode="US"/>
        <issueInfo issueNumber="001" inWork="00"/>
      </dmIdent>
      <dmAddressItems>
        <issueDate year="2026" month="05" day="19"/>
        <dmTitle>
          <techName>Hydraulic pump</techName>
          <infoName>Operational test</infoName>
        </dmTitle>
      </dmAddressItems>
    </dmAddress>
    <dmStatus issueType="new">
      <security securityClassification="01"/>
      <responsiblePartnerCompany enterpriseCode="HX20"/>
      <originator enterpriseCode="FICTV"/>
      <applic>
        <displayText>
          <simplePara>HX-20 MK1 and MK2 aircraft</simplePara>
        </displayText>
        <evaluate andOr="or">
          <assert applicPropertyIdent="model" applicPropertyType="prodattr" applicPropertyValues="mk1"/>
          <assert applicPropertyIdent="model" applicPropertyType="prodattr" applicPropertyValues="mk2"/>
        </evaluate>
      </applic>
      <brexDmRef>
        <dmRef>
          <dmRefIdent>
            <dmCode modelIdentCode="HX20" systemDiffCode="A" systemCode="00" subSystemCode="0" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="A" infoCode="022" infoCodeVariant="A" itemLocationCode="A"/>
          </dmRefIdent>
        </dmRef>
      </brexDmRef>
    </dmStatus>
  </identAndStatusSection>

  <content>
    <procedure>
      <preliminaryRqmts>
        <reqCondGroup>
          <reqCondNoRef>
            <reqCond>The hydraulic pump assembly is installed.</reqCond>
          </reqCondNoRef>
          <reqCondNoRef>
            <reqCond>All protective caps have been removed.</reqCond>
          </reqCondNoRef>
          <reqCondNoRef>
            <reqCond>Operational pressure limits and leakage criteria have been confirmed from approved engineering data.</reqCond>
          </reqCondNoRef>
        </reqCondGroup>
        <reqPersons>
          <person man="1"/>
        </reqPersons>
      </preliminaryRqmts>

      <mainProcedure>
        <proceduralStep>
          <para>Reconnect aircraft electrical power.</para>
        </proceduralStep>
        <proceduralStep>
          <para>Pressurize the hydraulic system.</para>
          <note>
            <para>Test pressure and hold time are controlled by the hydraulic system test limits data module and must be confirmed before release.</para>
            <dmRef>
              <dmRefIdent>
                <dmCode modelIdentCode="HX20" systemDiffCode="A" systemCode="29" subSystemCode="1" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="A" infoCode="320" infoCodeVariant="B" itemLocationCode="A"/>
              </dmRefIdent>
            </dmRef>
          </note>
        </proceduralStep>
        <proceduralStep>
          <para>Inspect hydraulic lines and fittings for leakage during operation.</para>
          <note>
            <para>Maximum permitted leakage rate is controlled by approved engineering data and is not invented in this portfolio example.</para>
          </note>
        </proceduralStep>
        <proceduralStep>
          <para>Verify stable hydraulic pressure during flight control surface checks.</para>
          <note>
            <para>Acceptable pressure range must be verified against the normal operating pressure reference before release.</para>
          </note>
        </proceduralStep>
        <proceduralStep>
          <para>Close access panel 32-A and secure fasteners.</para>
        </proceduralStep>
      </mainProcedure>

      <closeRqmts>
        <reqCondGroup>
          <reqCondNoRef>
            <reqCond>The hydraulic system has no visible leakage, pressure remains within the approved operating range and access panel 32-A is closed and secured.</reqCond>
          </reqCondNoRef>
        </reqCondGroup>
      </closeRqmts>
    </procedure>
  </content>
</dmodule>

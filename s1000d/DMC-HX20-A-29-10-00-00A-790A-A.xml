<dmodule>
  <identAndStatusSection>
    <dmAddress>
      <dmIdent>
        <dmCode modelIdentCode="HX20"
                systemDiffCode="A"
                systemCode="29"
                subSystemCode="1"
                subSubSystemCode="0"

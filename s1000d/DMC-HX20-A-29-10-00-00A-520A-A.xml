<?xml version="1.0" encoding="UTF-8"?>
<dmodule>
  <identAndStatusSection>
    <dmAddress>
      <dmIdent>
        <dmCode modelIdentCode="HX20"
                systemDiffCode="A"
                systemCode="29"
                subSystemCode="1"
                subSubSystemCode="0"
                assyCode="00"
                disassyCode="00"
                disassyCodeVariant="A"
                infoCode="520"
                infoCodeVariant="A"
                itemLocationCode="A"/>
        <language languageIsoCode="en" countryIsoCode="US"/>
        <issueInfo issueNumber="001" inWork="00"/>
      </dmIdent>
      <dmAddressItems>
        <issueDate year="2026" month="05" day="19"/>
        <dmTitle>
          <techName>Hydraulic pump</techName>
          <infoName>Remove procedure</infoName>
        </dmTitle>
      </dmAddressItems>
    </dmAddress>
    <dmStatus issueType="new">
      <security securityClassification="01"/>
      <responsiblePartnerCompany enterpriseCode="HX20"/>
      <originator enterpriseCode="FICTV"/>
      <applic>
        <displayText>
          <simplePara>HX-20 MK1 and MK2 aircraft</simplePara>
        </displayText>
        <evaluate andOr="or">
          <assert applicPropertyIdent="model" applicPropertyType="prodattr" applicPropertyValues="mk1"/>
          <assert applicPropertyIdent="model" applicPropertyType="prodattr" applicPropertyValues="mk2"/>
        </evaluate>
      </applic>
      <brexDmRef>
        <dmRef>
          <dmRefIdent>
            <dmCode modelIdentCode="HX20" systemDiffCode="A" systemCode="00" subSystemCode="0" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="A" infoCode="022" infoCodeVariant="A" itemLocationCode="A"/>
          </dmRefIdent>
        </dmRef>
      </brexDmRef>
    </dmStatus>
  </identAndStatusSection>

  <content>
    <procedure>
      <preliminaryRqmts>
        <reqCondGroup>
          <reqCondNoRef>
            <reqCond>Aircraft electrical power is disconnected.</reqCond>
          </reqCondNoRef>
          <reqCondNoRef>
            <reqCond>Hydraulic system pressure is released.</reqCond>
          </reqCondNoRef>
        </reqCondGroup>
        <reqPersons>
          <person man="1"/>
        </reqPersons>
        <reqSupportEquips>
          <supportEquipDescr>
            <name>Hydraulic pressure release tool</name>
          </supportEquipDescr>
        </reqSupportEquips>
      </preliminaryRqmts>

      <mainProcedure>
        <proceduralStep>
          <para>Disconnect electrical connector P-01 from the hydraulic pump assembly.</para>
        </proceduralStep>
        <proceduralStep>
          <para>Disconnect the hydraulic return and pressure lines.</para>
          <para>Install protective caps immediately after each line is disconnected.</para>
        </proceduralStep>
        <proceduralStep>
          <para>Remove the four mounting bolts from the support bracket.</para>
        </proceduralStep>
        <proceduralStep>
          <applic>
            <displayText>
              <simplePara>HX-20 MK2 aircraft</simplePara>
            </displayText>
            <evaluate andOr="and">
              <assert applicPropertyIdent="model" applicPropertyType="prodattr" applicPropertyValues="mk2"/>
            </evaluate>
          </applic>
          <para>Record the installed bracket type before the pump is lifted from the aircraft.</para>
        </proceduralStep>
        <proceduralStep>
          <para>Lift the hydraulic pump from the bracket and place it on a clean inspection surface.</para>
        </proceduralStep>
      </mainProcedure>

      <closeRqmts>
        <reqCondGroup>
          <reqCondNoRef>
            <reqCond>The hydraulic pump assembly is removed and ready for inspection or replacement.</reqCond>
          </reqCondNoRef>
        </reqCondGroup>
      </closeRqmts>
    </procedure>
  </content>
</dmodule>
